# Copy to .env and set OLLAMA_MODEL to a model you have already pulled on the host.
# Pilot models must be Apache 2.0 or MIT licensed. Check the model card before choosing.
# Talkback does not pick a model for you.
OLLAMA_MODEL=

# Address of host Ollama as seen from the API container.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# ollama (default) or vllm. vllm disables /llm/models, /llm/select, and /llm/pull.
# The vLLM path is not tested against a real vLLM server.
# CHAT_BACKEND=ollama
# CHAT_BASE_URL=http://vllm:8000/v1
OLLAMA_TIMEOUT=300

# Embedding model. Loaded from the local Hugging Face cache when OFFLINE_MODE=true.
# BAAI/bge-m3 is MIT. Set EMBED_MODEL=intfloat/multilingual-e5-small for the smaller model.
EMBED_MODEL=BAAI/bge-m3
# Chunks embedded per progress update. Progress is reported after each batch.
EMBED_BATCH=16

# Indexing and retrieval sized for a 16 GB laptop.
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVE_CANDIDATES=8
# BAAI/bge-reranker-v2-m3 is Apache-2.0 and loads from the local cache.
# On a GPU server it should run on the GPU. These defaults are sized for CPU.
# On a Mac, scripts/start-rerank-host.sh serves the same model on the Apple GPU.
# Leave this unset to score pairs inside the container.
# RERANK_URL=http://host.docker.internal:11435
# Same host process can embed BAAI/bge-m3 on MPS. Leave unset to embed in the container.
# EMBED_URL=http://host.docker.internal:11435
# RERANK_CANDIDATES=20
# RERANK_MAX_LENGTH=512
# RERANK_THRESHOLD=-7.5
# RERANK=true
RETRIEVE_LIMIT=4
RETRIEVE_PER_FILE=2
# The per-file cap applies only when the hits come from more files than this.
# RETRIEVE_BALANCE_FILES=3
# Similarity gate used only when RERANK=false. On e5-small, a CV question
# scored about 0.79 and an unrelated question topped out at 0.65.
RELEVANCE_THRESHOLD=0.75

# Ollama context and how long the model stays loaded between questions.
OLLAMA_CONTEXT=4096
OLLAMA_KEEP_ALIVE=30m
# false skips the hidden reasoning trace. Qwen 3.5 thinks unless this is set.
OLLAMA_THINK=false

# Torch CPU threads. Leave unset to use half the cores.
# TORCH_THREADS=4

# true refuses model downloads. The entrypoint then exports the Hugging Face
# offline flags before Python starts, and embeddings load from the local cache.
OFFLINE_MODE=true

# Absolute host path mounted at /app/data for the API and the indexer.
LIBRARY_PATH=/absolute/path/to/library
# true refuses upload and delete. Use it when LIBRARY_PATH is mounted read-only.
LIBRARY_READ_ONLY=false
# Optional incremental re-index interval in minutes. Leave unset to keep it off.
# REINDEX_INTERVAL_MINUTES=30

CHROMA_HOST=chromadb
CHROMA_PORT=8000

# User inside the API image. Defaults match this Mac checkout.
# Rebuild the image after changing these if the mounted folder is not readable.
# UID=502
# GID=20
