# Copy to .env and set OLLAMA_MODEL to a model you have already pulled on the host.
# Pilot models must be Apache 2.0 or MIT licensed. Check the model card before choosing.
# Talkback does not pick a model for you.
OLLAMA_MODEL=

# Address of host Ollama as seen from the API container.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT=300

# Embedding model. Loaded from the local Hugging Face cache when OFFLINE_MODE=true.
# Default covers French, English, and Spanish. BAAI/bge-m3 is the larger server option.
EMBED_MODEL=intfloat/multilingual-e5-small
# Chunks embedded per progress update. Progress is reported after each batch.
EMBED_BATCH=16

# Indexing and retrieval sized for a 16 GB laptop.
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVE_CANDIDATES=8
RETRIEVE_LIMIT=4
RETRIEVE_PER_FILE=2

# Ollama context and how long the model stays loaded between questions.
OLLAMA_CONTEXT=4096
OLLAMA_KEEP_ALIVE=30m

# Torch CPU threads. Leave unset to use half the cores.
# TORCH_THREADS=4

# true refuses model downloads and loads embeddings from the local cache only.
OFFLINE_MODE=true

# true treats the data directory as a read-only mount. Upload and delete are refused.
LIBRARY_READ_ONLY=false
# Optional incremental re-index interval in minutes. Leave unset to keep it off.
# REINDEX_INTERVAL_MINUTES=30

CHROMA_HOST=chromadb
CHROMA_PORT=8000
